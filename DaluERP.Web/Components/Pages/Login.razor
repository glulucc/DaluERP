@page "/login"
@rendermode InteractiveServer

@using DaluERP.Web.Services
@using DaluERP.Web.DTOs
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject AuthState AuthState
@inject DaluERPAuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Iniciar sesión - DaluERP</PageTitle>

<div class="login-container"> <div class="login-card">

    <h1>DaluERP</h1>
    <p class="login-subtitle">Iniciar sesión</p>

    <div class="form-group">
        <label for="correo">Correo electrónico</label>
        <input id="correo"
               type="email"
               class="form-control"
               @bind="correo"
               placeholder="correo@ejemplo.com" />
    </div>

    <div class="form-group">
        <label for="password">Contraseña</label>
        <input id="password"
               type="password"
               class="form-control"
               @bind="password"
               placeholder="Contraseña" />
    </div>

    @if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="alert alert-danger">
            @mensajeError
        </div>
    }

    <button class="btn btn-primary login-button"
            @onclick="IniciarSesion"
            disabled="@cargando">

        @if (cargando)
        {
            <span>Ingresando...</span>
        }
        else
        {
            <span>Ingresar</span>
        }

    </button>

</div>

</div>

@code {

private string correo = string.Empty;
private string password = string.Empty;
private string mensajeError = string.Empty;
private bool cargando;

private async Task IniciarSesion()
{
    mensajeError = string.Empty;

    if (string.IsNullOrWhiteSpace(correo))
    {
        mensajeError = "Ingrese su correo electrónico.";
        return;
    }

    if (string.IsNullOrWhiteSpace(password))
    {
        mensajeError = "Ingrese su contraseña.";
        return;
    }

    cargando = true;

    try
    {
        var resultado = await AuthService.LoginAsync(
            correo,
            password);

        if (resultado is null)
        {
            mensajeError = "Correo o contraseña incorrectos.";
            return;
        }

        AuthState.IniciarSesion(resultado);

        AuthenticationStateProvider.IniciarSesion(
            resultado.UsuarioId,
            resultado.Nombre,
            resultado.Correo,
            resultado.EsGlobal);

        Console.WriteLine(
            $"Login correcto: {resultado.Nombre}");

        Console.WriteLine(
            $"Empresa actual: {resultado.EmpresaActual?.Nombre}");

        Navigation.NavigateTo("/");
    }
    catch (Exception ex)
    {
        mensajeError =
            "No fue posible conectar con el servidor.";

        Console.WriteLine(ex);
    }
    finally
    {
        cargando = false;
    }
}

}